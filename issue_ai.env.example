# Reference only. configure_issue_ai.py creates private settings OUTSIDE the project.
# The planning scheduled-task Windows account must be the account that configures this.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
ISSUE_AI_MODEL=gpt-5.5
C4C_ISSUE_USERNAME=
C4C_ISSUE_PASSWORD=
C4C_ISSUE_AI_ENABLED=1
ISSUE_AI_MAX_PER_RUN=250
ISSUE_AI_BATCH_SIZE=10
